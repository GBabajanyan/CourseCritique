{
  "expo": {
    "name": "CourseCritique",
    "slug": "CourseCritique",
    "owner": "gbabaja",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "coursecritique",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.gbabaja.CourseCritique",
      "config": {
        "usesNonExemptEncryption": false
      },
      "appleTeamId": "CC77G22ZM8"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#003A5D",
        "foregroundImage": "./assets/images/teddy.png"
      },
      "package": "com.gbabaja.CourseCritique",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/teddy.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-mail-composer",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "We will use Face ID for authentication.",
          "fingerprintPermission": "We will use Fingerprint for authentication."
        }
      ],
      "expo-image",
      "expo-router",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4c5ae4df-4235-42f7-8a0f-ee4caa55545f"
      }
    }
  }
}
