{
  "expo": {
    "name": "CourseCritique",
    "slug": "CourseCritique",
    "owner": "gbabaja",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/teddy.png",
    "scheme": "coursecritique",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSFaceIDUsageDescription": "This app uses the camera to scan barcodes on event tickets."
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/teddy.png"
    },
    "splash": {
      "image": "./assets/images/teddy.png",
      "backgroundColor": "#003A5D"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#003A5D",
          "image": "./assets/images/teddy.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#003A5D"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
