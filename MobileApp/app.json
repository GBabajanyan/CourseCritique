{
  "expo": {
    "name": "CourseCritique",
    "slug": "CourseCritique",
    "owner": "gbabaja",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/teddy.png",
    "scheme": "coursecritique",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.gbabaja.CourseCritique",
      // "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#003A5D",
        "foregroundImage": "./assets/images/teddy.png"
      },
      "package": "com.gbabaja.CourseCritique"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/teddy.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "We will use Face ID for authentication.",
          "fingerprintPermission": "We will use Fingerprint for authentication."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
